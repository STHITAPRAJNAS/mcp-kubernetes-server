# =============================================================================
# MCP Kubernetes Server - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in appropriate values.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# ENVIRONMENT MODE
# -----------------------------------------------------------------------------
# Options: "local" | "aws"
# - "local": Uses kubeconfig file (~/.kube/config or KUBECONFIG env var)
# - "aws":   Uses AWS IAM role-based authentication for EKS
# - "auto":  Auto-detect based on environment (checks for AWS metadata endpoint)
MCP_K8S_ENV=auto

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# MCP server transport: "stdio" | "sse"
MCP_K8S_TRANSPORT=stdio

# SSE server host and port (only used when MCP_K8S_TRANSPORT=sse)
MCP_K8S_HOST=0.0.0.0
MCP_K8S_PORT=8080

# Server log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MCP_K8S_LOG_LEVEL=INFO

# Structured JSON logging (recommended for production)
MCP_K8S_JSON_LOGS=false

# Audit log file path (leave empty to log to stdout only)
MCP_K8S_AUDIT_LOG_FILE=

# -----------------------------------------------------------------------------
# LOCAL AUTHENTICATION
# -----------------------------------------------------------------------------
# Path to kubeconfig file (defaults to ~/.kube/config)
KUBECONFIG=

# Default Kubernetes context to use (leave empty to use current-context)
MCP_K8S_DEFAULT_CONTEXT=

# -----------------------------------------------------------------------------
# AWS AUTHENTICATION
# -----------------------------------------------------------------------------
# AWS Region where the EKS cluster(s) reside
AWS_DEFAULT_REGION=us-east-1

# AWS Profile to use (leave empty for default/instance role)
AWS_PROFILE=

# EKS Cluster name (for single-cluster setups)
MCP_K8S_EKS_CLUSTER_NAME=

# IAM Role ARN to assume before accessing EKS (for cross-account or least-privilege)
# Used when running locally but needing to assume an engineering role
MCP_K8S_AWS_ROLE_ARN=

# Duration (seconds) for assumed role credentials (min 900, max 43200)
MCP_K8S_AWS_ROLE_SESSION_DURATION=3600

# Session name when assuming a role
MCP_K8S_AWS_ROLE_SESSION_NAME=mcp-kubernetes-server

# -----------------------------------------------------------------------------
# SECURITY & SAFETY CONTROLS
# -----------------------------------------------------------------------------
# Enable destructive operations (delete, force-restart, etc.)
# Set to "false" in read-only/production monitoring contexts
MCP_K8S_ALLOW_DESTRUCTIVE=true

# Namespaces that are ALWAYS protected from destructive operations
# Comma-separated list. These cannot be overridden by tool arguments.
MCP_K8S_PROTECTED_NAMESPACES=kube-system,kube-public,kube-node-lease

# Require confirmation token for destructive operations
# When true, caller must pass a confirmation string matching the resource name
MCP_K8S_REQUIRE_DESTRUCTIVE_CONFIRMATION=true

# Maximum number of pods that can be deleted in a single batch operation
MCP_K8S_MAX_BATCH_DELETE=5

# Enable dry-run mode globally (all write operations simulate only)
MCP_K8S_DRY_RUN=false

# Mask secret values in all responses (always recommended)
MCP_K8S_MASK_SECRETS=true

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Max requests per minute per tool (0 = unlimited)
MCP_K8S_RATE_LIMIT_PER_MINUTE=120

# Max concurrent Kubernetes API calls
MCP_K8S_MAX_CONCURRENT_REQUESTS=10

# Request timeout in seconds
MCP_K8S_REQUEST_TIMEOUT=30

# -----------------------------------------------------------------------------
# MULTI-CLUSTER SUPPORT
# -----------------------------------------------------------------------------
# JSON mapping of cluster aliases to EKS cluster names (AWS mode)
# Example: {"prod": "my-prod-cluster", "staging": "my-staging-cluster"}
MCP_K8S_CLUSTER_MAP=

# Default cluster alias to use when not specified
MCP_K8S_DEFAULT_CLUSTER=

# -----------------------------------------------------------------------------
# APPROVAL WORKFLOW
# -----------------------------------------------------------------------------
# Require out-of-band approval for destructive operations (two-person integrity)
MCP_K8S_REQUIRE_APPROVAL=false

# Approval TTL in seconds (default 30 min)
MCP_K8S_APPROVAL_TTL_SECONDS=1800

# Webhook for approval notifications: Slack incoming webhook, Teams webhook, or generic HTTP
MCP_K8S_APPROVAL_WEBHOOK_URL=

# Webhook type: slack | teams | generic
MCP_K8S_APPROVAL_WEBHOOK_TYPE=slack

# Allow the requester to approve their own request (always false in production)
MCP_K8S_APPROVAL_ALLOW_SELF_APPROVE=false

# -----------------------------------------------------------------------------
# NAMESPACE-LEVEL WRITE SCOPING POLICY
# -----------------------------------------------------------------------------
# JSON array of policy rules. Example:
# [
#   {
#     "description": "App engineers - dev namespaces only",
#     "identity_patterns": ["arn:aws:iam::*/role/AppEngineer-*"],
#     "allowed_namespaces": ["dev-*", "test-*"],
#     "allowed_operations": ["READ", "WRITE"],
#     "require_approval_for": ["DELETE"]
#   },
#   {
#     "description": "SRE on-call - all namespaces except prod",
#     "identity_patterns": ["arn:aws:iam::*/role/SREOnCall", "*@sre.example.com"],
#     "allowed_namespaces": ["*"],
#     "denied_namespaces": ["prod-*"],
#     "allowed_operations": ["READ", "WRITE", "DELETE", "EXEC"],
#     "require_approval_for": []
#   },
#   {
#     "description": "Prod deploy pipeline - prod namespaces, deletes need approval",
#     "identity_patterns": ["arn:aws:iam::*/role/ProdDeploy"],
#     "allowed_namespaces": ["prod-*"],
#     "allowed_operations": ["READ", "WRITE", "DELETE"],
#     "require_approval_for": ["DELETE", "SCALE_TO_ZERO"]
#   }
# ]
MCP_K8S_NAMESPACE_POLICY=

# Path to a JSON file containing namespace policy rules (alternative to inline JSON)
MCP_K8S_NAMESPACE_POLICY_FILE=

# If true, identities with no matching policy are denied entirely (fail-closed)
# If false (default), unrecognized identities get read-only access
MCP_K8S_NAMESPACE_POLICY_DENY_UNKNOWN=false
